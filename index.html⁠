        // Carregar produtos customizados do localStorage ou usar padrão
        function loadProducts() {
            try {
                const saved = localStorage.getItem('evelyns_custom_products_v2');
                if (saved) {
                    products = JSON.parse(saved);
                } else {
                    products = JSON.parse(JSON.stringify(defaultProducts));
                }
            } catch (e) {
                console.error("Erro ao carregar do localStorage:", e);
                products = JSON.parse(JSON.stringify(defaultProducts));
            }
        }

        // Salvar estado atual no localStorage
        function saveProductsToStorage() {
            try {
                localStorage.setItem('evelyns_custom_products_v2', JSON.stringify(products));
                showToast("Alterações salvas no navegador!", "fa-circle-check", "text-emerald-400");
            } catch (e) {
                console.error("Erro ao salvar no localStorage:", e);
                showToast("Aviso: Espaço local cheio ou restrito.", "fa-triangle-exclamation", "text-amber-400");
            }
        }

        function showToast(message, icon = "fa-circle-check", iconColor = "text-emerald-400") {
            const toast = document.getElementById('toastNotification');
            const toastMsg = document.getElementById('toastMessage');
            const toastIcon = document.getElementById('toastIcon');

            if (!toast || !toastMsg) return;

            toastMsg.textContent = message;
            if (toastIcon) {
                toastIcon.className = `fa-solid ${icon} ${iconColor}`;
            }

            toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
            toast.classList.add('opacity-100', 'translate-y-0');

            setTimeout(() => {
                toast.classList.remove('opacity-100', 'translate-y-0');
                toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
            }, 3000);
        }

        function exportBackup() {
            try {
                const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(products, null, 2));
                const downloadAnchor = document.createElement('a');
                downloadAnchor.setAttribute("href", dataStr);
                downloadAnchor.setAttribute("download", `evelyns_catalogo_backup_${new Date().toISOString().slice(0,10)}.json`);
                document.body.appendChild(downloadAnchor);
                downloadAnchor.click();
                downloadAnchor.remove();
                showToast("Backup baixado com sucesso!", "fa-circle-down", "text-emerald-400");
            } catch (e) {
                console.error("Erro ao exportar backup:", e);
                showToast("Erro ao gerar backup.", "fa-circle-xmark", "text-rose-400");
            }
        }

        function importBackupFile(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const importedData = JSON.parse(e.target.result);
                    if (Array.isArray(importedData) && importedData.length > 0) {
                        products = importedData;
                        saveProductsToStorage();
                        updateCategoryCounts();
                        filterProducts();
                        renderEditProductList();
                        showToast("Catálogo restaurado do arquivo!", "fa-file-import", "text-emerald-400");
                    } else {
                        showToast("Arquivo de backup inválido.", "fa-circle-xmark", "text-rose-400");
                    }
                } catch (err) {
                    console.error("Erro ao importar backup:", err);
                    showToast("Formato de arquivo inválido.", "fa-circle-xmark", "text-rose-400");
                }
            };
            reader.readAsText(file);
        }

