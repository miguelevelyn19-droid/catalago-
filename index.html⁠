        function openEditFormForId(productId) {
            const modal = document.getElementById('editModal');
            if (modal.classList.contains('hidden')) {
                modal.classList.remove('hidden');
            }

            const prod = products.find(p => p.id === productId);
            if (!prod) return;

            document.getElementById('editProdId').value = prod.id;
            document.getElementById('editProdTitle').value = prod.title;
            document.getElementById('editProdDesc').value = prod.desc;
            document.getElementById('editProdPrice').value = prod.price;
            document.getElementById('editProdCategory').value = prod.category;
            document.getElementById('editProdImage').value = prod.image.startsWith('data:') ? '' : prod.image;
            document.getElementById('editProdPreview').src = prod.image;

            document.getElementById('editProductList').classList.add('hidden');
            document.getElementById('editFormContainer').classList.remove('hidden');
        }

        function closeEditForm() {
            document.getElementById('editProductList').classList.remove('hidden');
            document.getElementById('editFormContainer').classList.add('hidden');
        }

        function previewUploadedImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('editProdPreview').src = e.target.result;
                    document.getElementById('editProdImage').value = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function saveProductChanges(event) {
            event.preventDefault();
            const id = parseInt(document.getElementById('editProdId').value);
            const prod = products.find(p => p.id === id);

            if (prod) {
                prod.title = document.getElementById('editProdTitle').value.trim();
                prod.desc = document.getElementById('editProdDesc').value.trim();
                prod.price = document.getElementById('editProdPrice').value.trim();
                prod.category = document.getElementById('editProdCategory').value;
                
                const imgVal = document.getElementById('editProdImage').value.trim();
                if (imgVal) {
                    prod.image = imgVal;
                } else if (document.getElementById('editProdPreview').src) {
                    prod.image = document.getElementById('editProdPreview').src;
                }

                saveProductsToStorage();
                updateCategoryCounts();
                filterProducts();
                closeEditForm();
                renderEditProductList();
            }
        }

        function resetAllProducts() {
            localStorage.removeItem('evelyns_custom_products_v2');
            products = JSON.parse(JSON.stringify(defaultProducts));
            updateCategoryCounts();
            filterProducts();
            closeEditForm();
            renderEditProductList();
        }

        // Carregamento Inicial
        window.onload = function() {
            loadProducts();
            updateCategoryCounts();
            filterProducts();
        };
    </script>
</body>
</html>