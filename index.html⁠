        function renderModalCategories() {
            const container = document.getElementById('filterModalCategories');
            const categoriesKeys = Object.keys(categoryInfo);

            container.innerHTML = categoriesKeys.map(catKey => {
                const count = catKey === 'all' 
                    ? products.length 
                    : products.filter(p => p.category === catKey).length;

                const isSelected = currentCategory === catKey;
                const activeClasses = isSelected 
                    ? 'bg-rose-600 text-white font-bold shadow-xs' 
                    : 'bg-white text-gray-700 border border-gray-200 hover:bg-rose-50';

                return `
                    <button onclick="selectCategoryFromModal('${catKey}')" 
                            class="w-full p-2.5 rounded-xl text-left flex items-center justify-between transition-all ${activeClasses}">
                        <div class="flex items-center gap-2.5">
                            <i class="fa-solid ${categoryInfo[catKey].icon} text-sm ${isSelected ? 'text-white' : 'text-rose-500'}"></i>
                            <span>${categoryInfo[catKey].name}</span>
                        </div>
                        <span class="text-[11px] px-2 py-0.5 rounded-full ${isSelected ? 'bg-white/20 text-white' : 'bg-rose-100 text-rose-700'} font-semibold">
                            ${count} ${count === 1 ? 'item' : 'itens'}
                        </span>
                    </button>
                `;
            }).join('');
        }

        function selectCategoryFromModal(catKey) {
            currentCategory = catKey;
            
            document.querySelectorAll('.cat-btn').forEach(btn => {
                const isTarget = btn.getAttribute('data-cat') === catKey;
                if (isTarget) {
                    btn.classList.remove('bg-gray-100', 'text-gray-600');
                    btn.classList.add('bg-rose-600', 'text-white', 'shadow-xs');
                } else {
                    btn.classList.remove('bg-rose-600', 'text-white', 'shadow-xs');
                    btn.classList.add('bg-gray-100', 'text-gray-600');
                }
            });

            renderModalCategories();
            filterProducts();
        }

        function setSortOption(sortKey) {
            currentSort = sortKey;
            
            document.querySelectorAll('.sort-btn').forEach(btn => {
                btn.className = 'sort-btn p-2.5 rounded-xl border border-gray-200 text-gray-700 hover:bg-gray-50 text-left flex items-center justify-between';
                const icon = btn.querySelector('i');
                if(icon) icon.className = 'fa-solid fa-circle-check text-gray-300';
            });

            const activeBtn = document.getElementById(`sort-${sortKey}`);
            if (activeBtn) {
                activeBtn.className = 'sort-btn p-2.5 rounded-xl border border-rose-200 text-rose-700 bg-rose-50 font-semibold text-left flex items-center justify-between';
                const icon = activeBtn.querySelector('i');
                if(icon) icon.className = 'fa-solid fa-circle-check text-rose-600';
            }

            filterProducts();
        }

        function updateCategoryCounts() {
            Object.keys(categoryInfo).forEach(catKey => {
                const countEl = document.getElementById(`count-${catKey}`);
                if (countEl) {
                    const cnt = catKey === 'all' 
                        ? products.length 
                        : products.filter(p => p.category === catKey).length;
                    countEl.textContent = `(${cnt})`;
                }
            });
        }

        function filterProducts() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            
            let filtered = products.filter(p => {
                const matchesCat = currentCategory === 'all' || p.category === currentCategory;
                const matchesSearch = p.title.toLowerCase().includes(query) || 
                                      p.desc.toLowerCase().includes(query);
                return matchesCat && matchesSearch;
            });

            if (currentSort === 'az') {
                filtered.sort((a, b) => a.title.localeCompare(b.title));
            } else if (currentSort === 'za') {
                filtered.sort((a, b) => b.title.localeCompare(a.title));
            } else {
                filtered.sort((a, b) => a.id - b.id);
            }

            const filterBadge = document.getElementById('activeFilterBadge');
            if (currentCategory !== 'all' || currentSort !== 'default' || query !== '') {
                filterBadge.classList.remove('hidden');
            } else {
                filterBadge.classList.add('hidden');
            }

            renderProducts(filtered);
        }

        function setCategory(cat, btnElement) {
            currentCategory = cat;
            
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.classList.remove('bg-rose-600', 'text-white', 'shadow-xs');
                btn.classList.add('bg-gray-100', 'text-gray-600');
            });

            btnElement.classList.remove('bg-gray-100', 'text-gray-600');
            btnElement.classList.add('bg-rose-600', 'text-white', 'shadow-xs');

            filterProducts();
        }

